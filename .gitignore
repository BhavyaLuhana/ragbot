# ─────────────────────────────────────────────────────────────
# RAG System — root .gitignore
# ─────────────────────────────────────────────────────────────

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual envs
.venv/
venv/
env/
ENV/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ── Node / React / Vite ──────────────────────────────────────
node_modules/
.pnp
.pnp.js
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
*.local

# npm/yarn/pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment / secrets ────────────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# ── Project data (do NOT commit) ─────────────────────────────
# Raw source document — user's private PDF
data/raw/*
!data/raw/.gitkeep

# ChromaDB persistent store — regenerated by ingestion
data/chroma/*
!data/chroma/.gitkeep

# BM25 pickle + docstore — regenerated by ingestion
data/bm25/*
!data/bm25/.gitkeep

# Eval artifacts — results are regenerated; qa_set.json IS committed
data/eval/results.json
data/eval/ablation.csv
data/eval/.cache/

# ── Docker ───────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# ── IDE / editors ────────────────────────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
!.gitkeep

# ── Misc ─────────────────────────────────────────────────────
*.bak
*.tmp
.cache/