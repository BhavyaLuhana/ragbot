# ─────────────────────────────────────────────────────────────
# RAG System — environment template
# Copy to .env and fill in real values. .env is gitignored.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Environment ──────────────────────────────────────────────
ENVIRONMENT=local
LOG_LEVEL=INFO

# ── Providers (ADR-016) ──────────────────────────────────────
# Default: Ollama (no key needed)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Alternative: OpenAI — uncomment to switch
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800

# ── Retrieval ────────────────────────────────────────────────
DENSE_TOP_K=20
SPARSE_TOP_K=20
FUSION_TOP_K=20
FINAL_TOP_K=5
RRF_K=60

# ── Feature toggles (ablation, ADR-009) ─────────────────────
HYDE_ENABLED=true
RETRIEVAL_DENSE_ONLY=false
RETRIEVAL_HYBRID=true
RETRIEVAL_RERANK=true

# ── Chunking (ADR-002) ───────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ── Reranker (ADR-006) ───────────────────────────────────────
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# ── Service URLs ─────────────────────────────────────────────
INGESTION_URL=http://localhost:8001
RETRIEVAL_URL=http://localhost:8002
CHAT_URL=http://localhost:8003
FRONTEND_ORIGIN=http://localhost:5173

# ── HTTP ─────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30.0
HTTP_MAX_RETRIES=1
SSE_HEARTBEAT_SECONDS=15

# ── Eval ─────────────────────────────────────────────────────
EVAL_SET_SIZE=25